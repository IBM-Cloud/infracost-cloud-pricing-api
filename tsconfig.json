{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "lib": ["es2021"],
    "target": "ES2021",
    "module": "commonjs",
    "esModuleInterop": true,
    "declaration": true,
    "typeRoots": [ "../../typings", "./node_modules/@types"]
  },
  "include": ["src/**/*"]
}
